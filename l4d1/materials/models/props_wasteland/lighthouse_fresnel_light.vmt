VertexLitGeneric
{
$basetexture "models/props_wasteland\lighthouse_fresnel_light"
$bumpmap "models/props_wasteland\lighthouse_fresnel_light_normal"
$surfaceprop glass
$selfillum 1

$selfillumtint "[1.0 1.0 1.0]"

$phong 1
$phongexponent 20
$phongboost 2
$phongfresnelranges "[.1 .5 1]"
$rimlight 1
$rimlightexponent 8
$rimlightboost 6
$envmap env_cubemap

}
