LightmappedGeneric
{
$basetexture "shadertest/LightmappedSelfIlluminatedTexture"
$selfillum 1
$detail "shadertest/shadertestdetail"
$temp 0
$one 1
Proxies
{

Sine
{
resultVar $temp
sineperiod 30.00
sinemin 0
sinemax 360.0
}
TextureTransform
{
rotateVar $temp
resultVar $basetexturetransform
}

Sine
{
resultVar "$color[1]"
sineperiod 10.00
sinemin 0
sinemax 1
}

Sine
{
resultVar $detailscale
sineperiod 10.00
sinemin 2
sinemax 20
}

PlayerSpeed
{
resultVar $temp
scale 0.01
}
Subtract
{
srcVar1 $one
srcVar2 $temp
resultVar "$selfillumtint[0]"
}
}
}
