patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\shot_xm1014\shot_xm1014_surface"
		"$maskstexture" "models\weapons\customization\shot_xm1014\shot_xm1014_masks"
		"$aotexture" "models\weapons\customization\shot_xm1014\shot_xm1014_ao"
		"$postexture" "models\weapons\customization\shot_xm1014\shot_xm1014_pos"
		"$exptexture" "models\weapons\v_models\shot_xm1014\shot_xm1014_exponent"
		"$WEARTEXTURETRANSFORM" "scale 2.06 2.06 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 2.06 2.06 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 1.0327
		"$PREVIEWWEAPONUVSCALE" 0.54
	}
}