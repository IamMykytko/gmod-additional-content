patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\smg_p90\smg_p90_surface"
		"$maskstexture" "models\weapons\customization\smg_p90\smg_p90_masks"
		"$aotexture" "models\weapons\customization\smg_p90\smg_p90_ao"
		"$postexture" "models\weapons\customization\smg_p90\smg_p90_pos"
		"$exptexture" "models\weapons\v_models\smg_p90\smg_p90_exponent"
		"$WEARTEXTURETRANSFORM" "scale 1.09 1.09 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 1.09 1.09 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 0
		
		// SET THIS IF $ENVMAP IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWENVMAP" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 0.545
		"$PREVIEWWEAPONUVSCALE" 0.537
	}
}