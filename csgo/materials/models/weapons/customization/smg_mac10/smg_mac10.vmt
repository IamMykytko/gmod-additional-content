patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\smg_mac10\smg_mac10_surface"
		"$maskstexture" "models\weapons\customization\smg_mac10\smg_mac10_masks"
		"$aotexture" "models\weapons\customization\smg_mac10\smg_mac10_ao"
		"$postexture" "models\weapons\customization\smg_mac10\smg_mac10_pos"
		"$exptexture" "models\weapons\v_models\smg_mac10\smg_mac10_1_exponent"
		"$WEARTEXTURETRANSFORM" "scale .713 .713 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale .713 .713 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// SET THIS IF $ENVMAP IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWENVMAP" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 0.3565
		"$PREVIEWWEAPONUVSCALE" 0.495
	}
}