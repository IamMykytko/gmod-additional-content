patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\rif_sg556\rif_sg556_surface"
		"$maskstexture" "models\weapons\customization\rif_sg556\rif_sg556_masks"
		"$aotexture" "models\weapons\customization\rif_sg556\rif_sg556_ao"
		"$postexture" "models\weapons\customization\rif_sg556\rif_sg556_pos"
		"$exptexture" "models\weapons\v_models\rif_sg556\rif_sg556_exponent"
		"$WEARTEXTURETRANSFORM" "scale 2.01 2.01 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 2.01 2.01 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		//"$PREVIEWWEAPONOBJSCALE" 
		//"$PREVIEWWEAPONUVSCALE" 
		
		"$PREVIEWWEAPONOBJSCALE" 1.009 
		"$PREVIEWWEAPONUVSCALE" 0.809
	}
}