patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\rif_m4a1_s\rif_m4a1_s_surface"
		"$maskstexture" "models\weapons\customization\rif_m4a1_s\rif_m4a1_s_masks"
		"$aotexture" "models\weapons\customization\rif_m4a1_s\rif_m4a1_s_ao"
		"$postexture" "models\weapons\customization\rif_m4a1_s\rif_m4a1_s_pos"
		"$exptexture" "models\weapons\v_models\rif_m4a1_s\rif_m4a1_s_exponent"
		"$WEARTEXTURETRANSFORM" "scale 2.44 2.44 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 2.44 2.44 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// SET THIS IF $ENVMAP IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWENVMAP" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 1.318
		"$PREVIEWWEAPONUVSCALE" 0.9167
	}
}