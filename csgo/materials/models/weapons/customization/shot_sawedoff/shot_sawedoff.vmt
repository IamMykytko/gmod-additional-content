patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\shot_sawedoff\shot_sawedoff_surface"
		"$maskstexture" "models\weapons\customization\shot_sawedoff\shot_sawedoff_masks"
		"$aotexture" "models\weapons\customization\shot_sawedoff\shot_sawedoff_ao"
		"$postexture" "models\weapons\customization\shot_sawedoff\shot_sawedoff_pos"
		"$exptexture" "models\weapons\v_models\shot_sawedoff\shot_sawedoff_01_exponent"
		"$WEARTEXTURETRANSFORM" "scale 1.47 1.47 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 1.47 1.47 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 0.7357
		"$PREVIEWWEAPONUVSCALE" 0.445
	}
}