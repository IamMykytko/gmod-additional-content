patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\pist_hkp2000\pist_hkp2000_surface"
		"$maskstexture" "models\weapons\customization\pist_hkp2000\pist_hkp2000_masks"
		"$aotexture" "models\weapons\customization\pist_hkp2000\pist_hkp2000_ao"
		"$postexture" "models\weapons\customization\pist_hkp2000\pist_hkp2000_pos"
		"$exptexture" "models\weapons\v_models\pist_hkp2000\pist_hkp2000_exponent"
		"$WEARTEXTURETRANSFORM" "scale .42 .42 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale .42 .42 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// SET THIS IF $ENVMAP IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWENVMAP" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 0.2098
		"$PREVIEWWEAPONUVSCALE" 0.288
	}
}