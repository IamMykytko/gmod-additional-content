patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\snip_ssg08\snip_ssg08_scope_surface"
		"$maskstexture" "models\weapons\customization\snip_ssg08\snip_ssg08_scope_masks"
		"$aotexture" "models\weapons\customization\snip_ssg08\snip_ssg08_scope_ao"
		"$postexture" "models\weapons\customization\snip_ssg08\snip_ssg08_scope_pos"
		"$exptexture" "models\weapons\v_models\snip_ssg08\snip_ssg08_scope_exponent"
		"$WEARTEXTURETRANSFORM" "scale 0.77 0.77 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 0.77 0.77 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 0.384
		"$PREVIEWWEAPONUVSCALE" 0.424
	}
}