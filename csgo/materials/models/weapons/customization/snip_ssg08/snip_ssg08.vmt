patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------
		"$basetexture" "models\weapons\customization\snip_ssg08\snip_ssg08"
		"$surfacetexture" "models\weapons\customization\snip_ssg08\snip_ssg08_surface"
		"$maskstexture" "models\weapons\customization\snip_ssg08\snip_ssg08_masks"
		"$aotexture" "models\weapons\customization\snip_ssg08\snip_ssg08_ao"
		"$postexture" "models\weapons\customization\snip_ssg08\snip_ssg08_pos"
		"$exptexture" "models\weapons\v_models\snip_ssg08\snip_ssg08_exponent"
		"$WEARTEXTURETRANSFORM" "scale 2.73 2.73 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 2.73 2.73 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 1.366
		"$PREVIEWWEAPONUVSCALE" 1.084
	}
}