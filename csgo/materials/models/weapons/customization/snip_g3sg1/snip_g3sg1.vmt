patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------
		"$basetexture" "models\weapons\customization\snip_g3sg1\snip_g3sg1"
		"$surfacetexture" "models\weapons\customization\snip_g3sg1\snip_g3sg1_surface"
		"$maskstexture" "models\weapons\customization\snip_g3sg1\snip_g3sg1_masks"
		"$aotexture" "models\weapons\customization\snip_g3sg1\snip_g3sg1_ao"
		"$postexture" "models\weapons\customization\snip_g3sg1\snip_g3sg1_pos"
		"$exptexture" "models\weapons\v_models\snip_g3sg1\snip_g3sg1_exponent"
		"$WEARTEXTURETRANSFORM" "scale 2.33 2.33 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 2.33 2.33 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 1.166
		"$PREVIEWWEAPONUVSCALE" 0.703
	}
}