patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------
		"$basetexture"	"models\weapons\customization\pist_deagle\pist_deagle"
		
		"$surfacetexture" "models\weapons\customization\pist_deagle\pist_deagle_surface"
		"$maskstexture" "models\weapons\customization\pist_deagle\pist_deagle_masks"
		"$aotexture" "models\weapons\customization\pist_deagle\pist_deagle_ao"
		"$postexture" "models\weapons\customization\pist_deagle\pist_deagle_pos"
		"$exptexture" "models\weapons\v_models\pist_deagle\pist_deagle_exponent"
		"$WEARTEXTURETRANSFORM" "scale .63 .63 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale .63 .63 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// SET THIS IF $ENVMAP IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWENVMAP" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 0.316
		"$PREVIEWWEAPONUVSCALE" 0.3
		
	}
}