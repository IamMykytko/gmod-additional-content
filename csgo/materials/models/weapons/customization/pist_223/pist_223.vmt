patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\pist_223\pist_223_surface"
		"$maskstexture" "models\weapons\customization\pist_223\pist_223_masks"
		"$aotexture" "models\weapons\customization\pist_223\pist_223_ao"
		"$postexture" "models\weapons\customization\pist_223\pist_223_pos"
		"$exptexture" "models\weapons\v_models\pist_223\pist_223_exponent"
		"$WEARTEXTURETRANSFORM" "scale 1 1 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 1 1 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// SET THIS IF $ENVMAP IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWENVMAP" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 0.5
		"$PREVIEWWEAPONUVSCALE" 0.516
	}
}