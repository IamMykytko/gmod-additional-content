patch
{

	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------
		"$basetexture"	"models\weapons\customization\pist_glock18\pist_glock18"
		
		"$surfacetexture" "models\weapons\customization\pist_glock18\pist_glock18_surface"
		"$maskstexture" "models\weapons\customization\pist_glock18\pist_glock18_masks"
		"$aotexture" "models\weapons\customization\pist_glock18\pist_glock18_ao"
		"$postexture" "models\weapons\customization\pist_glock18\pist_glock18_pos"
		"$exptexture" "models\weapons\v_models\pist_glock18\pist_glock18_exponent"
		"$WEARTEXTURETRANSFORM" "scale .44 .44 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale .44 .44 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 0.2216
		"$PREVIEWWEAPONUVSCALE" 0.446
	}
}