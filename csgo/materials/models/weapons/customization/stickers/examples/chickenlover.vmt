weapondecal
{
	$basetexture models\weapons\customization\stickers\examples\sticker_chickenlover
	$decalstyle 1
	$unwearstrength 0.16
	$envmap "env_cubemap"
	$envmaptint "[ .07 .07 .07 ]"
	$phong 1
	$phongexponent	2
	$phongfresnelranges "[ .2 .5 1 ]"
	$phongalbedotint 1.0
	$phongboost 1.0
	$phongalbedoboost 10.0	
}