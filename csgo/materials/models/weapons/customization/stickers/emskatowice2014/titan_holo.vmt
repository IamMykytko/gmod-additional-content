weapondecal
{	
	$basetexture models\weapons\customization\stickers\emskatowice2014\sticker_titan
	$decalstyle 3
	$holomask models\weapons\customization\stickers\emskatowice2014\sticker_titan_holomask
	$holospectrum models\weapons\customization\stickers\default\holowarp_blue
	$wearbias 0.16
	$unwearstrength 0.32
	$envmap "env_cubemap"
	$envmaptint "[ .01 .01 .08 ]"
	$phong 1
	$phongexponent 1.0
	$phongfresnelranges "[ .2 .5 1 ]"
	$phongalbedotint 0.3
	$phongboost 1.0
	$phongalbedoboost 10.0	
}