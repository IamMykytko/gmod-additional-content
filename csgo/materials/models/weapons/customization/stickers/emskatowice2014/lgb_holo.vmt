weapondecal
{	
	$basetexture models\weapons\customization\stickers\emskatowice2014\sticker_lgb
	$decalstyle 3
	$holomask models\weapons\customization\stickers\emskatowice2014\sticker_lgb_holomask
	$holospectrum models\weapons\customization\stickers\default\holowarp_red
	$wearbias 0
	$unwearstrength 0.16
	$envmap "env_cubemap"
	$envmaptint "[ .08 0 0 ]"
	$phong 1
	$phongexponent 1.0
	$phongfresnelranges "[ .2 .5 1 ]"
	$phongalbedotint 0.3
	$phongboost 1.0
	$phongalbedoboost 10.0	
}