weapondecal
{
	$basetexture models\weapons\customization\stickers\atlanta2017\hlr
	$holomask	 models\weapons\customization\stickers\atlanta2017\hlr_holomask
	$holospectrum models\weapons\customization\stickers\cologne2016\spectrum_red
	$decalstyle 3
	$colortint "[255 255 255]"
	$wearremapmin 0.3
	$wearbias 0.1
	$unwearstrength 0.1
	$envmap "env_cubemap"
	$envmaptint "[ 0.02 0.02 0.02 ]"
	$phong 1
	$phongexponent	2
	$phongfresnelranges "[ .1 .25 .5 ]"
	$phongalbedotint 1.0
	$phongboost 1.0
	$phongalbedoboost 5.0
}