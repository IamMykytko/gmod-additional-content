WeaponDecal
	{	
		$basetexture models\weapons\customization\stickers\stickers2\bish
		$HOLOMASK models\weapons\customization\stickers\stickers2\bish_holomask
		$HOLOSPECTRUM models\weapons\customization\stickers\default\holowarp_default
		$DECALSTYLE 3 		//holographic sticker style
		$unwearstrength 0.18
		$envmap "env_cubemap"
		$envmaptint "[ .07 .07 .07 ]"
		$PHONG 1
		$PHONGEXPONENT	2
		$PHONGFRESNELRANGES "[ .2 .5 1 ]"
		$PHONGALBEDOTINT 1.0
		$PHONGBOOST 1.0
		$PHONGALBEDOBOOST 10.0
	}