WeaponDecal
{	
	$basetexture models\weapons\customization\stickers\standard\dispatch
	
	$unwearstrength 0.08
	
	$DECALSTYLE 1 // Standard paper-backed plastic sticker
	
	$envmap "env_cubemap"
	$envmaptint "[ .03 .03 .03 ]"
	
	$PHONG 1
	$PHONGEXPONENT	2
	$PHONGFRESNELRANGES "[ .2 .5 1 ]"
	$PHONGALBEDOTINT 1.0
	$PHONGBOOST 0.5
	$PHONGALBEDOBOOST 10.0
}