WeaponDecal
{	
	$basetexture models\weapons\customization\stickers\standard\vigilance_foil
	$HOLOMASK models\weapons\customization\stickers\standard\vigilance_foil_holomask
	$HOLOSPECTRUM models\weapons\customization\stickers\standard\silver_gold
	$DECALSTYLE 3 		//holographic sticker style
	$unwearstrength 0.06
	$envmap "env_cubemap"
	$envmaptint "[ .01 .01 .01 ]"
	$PHONG 1
	$PHONGEXPONENT	2
	$PHONGFRESNELRANGES "[ .05 .2 .3 ]"
	$PHONGALBEDOTINT 1.0
	$PHONGBOOST 1.0
	$PHONGALBEDOBOOST 1
}	