weapondecal
{
	$basetexture models\weapons\customization\stickers\columbus2016\gamb
	$holomask	 models\weapons\customization\stickers\columbus2016\gamb_holomask
	$holospectrum models\weapons\customization\stickers\columbus2016\spectrum
	$decalstyle 3
	$colortint "[144 144 144]"
	$wearremapmin 0.3
	$wearbias 0.1
	$unwearstrength 0.1
	$envmap "env_cubemap"
