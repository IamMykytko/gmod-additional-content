patch
{
	include "materials\models\weapons\customization\paints\master.vmt"
	
	insert 	
	{
		//-------------------------------------------------
		// MUST SET THIS BLOCK PER WEAPON
		//-------------------------------------------------

		"$surfacetexture" "models\weapons\customization\smg_mp5sd\smg_mp5sd_surface"
		"$maskstexture" "models\weapons\customization\smg_mp5sd\smg_mp5sd_masks"
		"$aotexture" "models\weapons\customization\smg_mp5sd\smg_mp5sd_ao"
		"$postexture" "models\weapons\customization\smg_mp5sd\smg_mp5sd_pos"
		"$exptexture" "models\weapons\v_models\smg_mp5sd\smg_mp5sd_exponent"
		"$WEARTEXTURETRANSFORM" "scale 2.1 2.1 translate 0 0 rotate 0"
		"$GRUNGETEXTURETRANSFORM" "scale 2.1 2.1 translate 0 0 rotate 0"
		
		// SET THIS IF $PHONGALBEDOTINT IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWPHONGALBEDOTINT" 1
		
		// SET THIS IF $ENVMAP IS ENABLED ON THE ORIGINAL WEAPON MATERIAL
		"$PREVIEWENVMAP" 1
		
		// WEAR PROGRESSION FACTOR
		"$WEARPROGRESS" 0.2
		
		"$PREVIEWWEAPONOBJSCALE" 1.0485
		"$PREVIEWWEAPONUVSCALE" 0.549
	}
}