	$detailscale			"[ 2.800 2.100 2.000 4.000 ]"
	$detailphongalbedotint 	"[ 0.000 1.000 0.600 0.000 ]"
	$detailnormaldepth		"[ 1.600 1.000 3.000 1.300 ]"
	$detailenvboost 		"[ 0.050 1.000 0.000 0.000 ]"
	$detailphongboost 		"[ 0.400 4.000 0.000 0.150 ]"
	$detailwarpindex 		"[ 0.000 0.000 0.023 0.023 ]"
	$detailmetalness 		"[ 1.000 0.500 1.000 1.000 ]"
	
	"$palettecolor1" "[  155 151 134 ]" 	// back of hand
	"$palettecolor2" "[  163 132 115 ]" 	// brokenfang
	"$palettecolor3" "[ 147 118 98 ]" 	// spikes
	"$palettecolor4" "[  99  74  74 ]" 	// snap and grommits
	"$palettecolor5" "[  43 25 18 ]" 	// trim
	"$palettecolor6" "[  58 33 30 ]" 	// bloodhound leather area and palm
	"$palettecolor7" "[  88 49 44 ]" 	// connector leather
	"$palettecolor8" "[  40 12 11  ]" 	// fabric

	//PATTERN
	$pattern					"models\weapons\customization\paints\anodized_multi\mirage_flowers"
	$patternreplaceindex		1
	$patterncolorindices		"[ 1 5 7 6 ]"
	$patterndetailinfluence 	0.5
	$patternpaintthickness 		0.8
	$pattern_offset_x_start		0
	$pattern_offset_x_end		1
	$pattern_offset_y_start		0
	$pattern_offset_y_end		1
	$pattern_rotate_start		0
	$pattern_rotate_end			360
	$patternscale				2.60
	$grungescale 				1.60
	
	//GRUNGE
	$grunge			models/weapons/customization/glove_bloodhound/grunge
	$weargrunge 	"[ 0.400 2.100 0.000 0.400 ]"
	$damagegrunge	"[ 0.520 1.000 0.100 0.400 ]"
	$detailgrunge 	"[ 0.300 0.100 0.000 0.000 ]"
	
	//DAMAGE
	$damagelevels1 			"[ 0.080 0.100 ]"
	$damagelevels2 			"[ 0.400 0.980 ]"
	$damagelevels3 			"[ 0.000 1.000 ]"
	$damagelevels4 			"[ 0.000 1.000 ]"
	$damagenormaledgedepth 	"[ 1.500 2.000 1.000 0.000 ]"
	$damageedgephongboost 	"[ 0.100 0.800 0.000 0.000 ]"
	$damageedgeenvboost 	"[ 0.000 1.000 0.000 0.000 ]"
	$damagedetailphongboost "[ 0.010 0.200 0.000 0.000 ]"
	$damagedetailenvboost 	"[ 0.000 0.050 0.000 0.000 ]"
	$damagedetailsaturation "[ 0.100 -0.00 0.300 0.000 ]"
	$damagedetailbrightnessadjustment "[ -0.400 1.000 0.000 0.000 ]"
	
	//WEAR
	$curvaturewearboost		"[ 0.400 0.320 1.000 0.000 ]"
	$curvaturewearpower 	"[ 3.000 3.500 0.800 1.000 ]"
	$weardetailphongboost	"[ -1.00 0.800 0.000 0.000 ]"
