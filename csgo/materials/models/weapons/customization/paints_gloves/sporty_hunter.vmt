customcharacter
{
	$materialmask			models/weapons/customization/glove_sporty/material_mask01
 	$ao						models/weapons/customization/glove_sporty/ao
	
	$detail					models/weapons/customization/glove_sporty/detail7
	$detailnormal			models/weapons/customization/glove_sporty/detailnormal7
	$detailscale 			"[ 2.500 5.000 2.000 6.000 ]"
	$detailphongboost 		"[ 0.001 0.005 0.005 0.005 ]"
	$detailenvboost 		"[ 0.000 0.000 0.020 0.000 ]"
	$detailphongalbedotint 	"[ 0.400 0.400 0.000 0.000 ]"
	$detailwarpindex 		"[ 0.000 0.010 0.086 0.025 ]"
	$detailmetalness 		"[ 1.000 1.000 1.000 1.000 ]"
	$detailnormaldepth 		"[ 2.000 0.500 1.000 3.000 ]"
 	
	"$palettecolor1" "[ 180 190 178 ]"  // wear color
	"$palettecolor2" "[  67  62  53 ]"  // back of fingers, wrist strap, and inner stitching
	"$palettecolor3" "[ 190 138  57 ]"  // palm pad and thumb wrap
	"$palettecolor4" "[ 86 48 10 ]"  // back of hand detail
	"$palettecolor5" "[  23 21 17 ]"  // between fingers and lower trim/stitching
	"$palettecolor6" "[ 67  62  53 ]"  // back of hand lines
	"$palettecolor7" "[ 225 142  12 ]"  // strap logo
	"$palettecolor8" "[  43  43  40 ]"  // palm
	
	//PATTERN
	$pattern					"models\weapons\customization\paints\hydrographic\hunter_blaze_orange"
	$patternreplaceindex		4
	$patterncolorindices		"[ 5 7 4 1 ]"
	$patterndetailinfluence 	0.00
	$patternpaintthickness 		0.00
	$pattern_offset_x_start		0
	$pattern_offset_x_end		1
	$pattern_offset_y_start		0
	$pattern_offset_y_end		1
	$pattern_rotate_start		30.0
	$pattern_rotate_end			30.0
	$patternscale				1.5
	$grungescale 				2.50
	
	//GRUNGE
	$grunge			models/weapons/customization/glove_sporty/grunge
	$grime 			"[ 0.80 0.00 0.10 0.40 ]"
	$damagegrunge	"[ 0.20 0.50 0.10 0.40 ]"
	$detailgrunge 	"[ 0.00 0.05 0.10 0.10 ]"
	
	//DAMAGE
	$damagelevels1 			"[ 0.018 0.090 ]"
	$damagelevels2 			"[ 0.007 0.016 ]"
	$damagelevels3 			"[ 0.010 0.020 ]"
	$damagelevels4 			"[ 0.018 0.090 ]"
	$damagedetailphongboost "[ 0.100 -0.10 0.000 0.000 ]"
	$damagedetailenvboost 	"[ 0.000 -1.00 0.000 0.000 ]"
	$damagenormaledgedepth 	"[ 0.500 2.000 1.000 1.000 ]"
	$damageedgephongboost 	"[ 0.000 0.000 0.000 0.000 ]"	
	$damageedgeenvboost 	"[ 0.000 0.000 0.000 0.000 ]"
	$damagedetailsaturation "[ -0.70 0.000 0.500 -1.50 ]"
	$damagedetailbrightnessadjustment "[ 0.500 -0.600 -0.200 0.200 ]"
	
	//WEAR
	$curvaturewearboost		"[ 0.400 0.620 0.100 0.100 ]"
	$curvaturewearpower		"[ 3.000 4.300 4.000 3.000 ]"
	$weardetailphongboost 	"[ 0.000 -1.00 0.000 0.000 ]"
	$weardetailenvboost 	"[ 0.000 0.000 0.000 0.000 ]"
	$wearexponent			0.70
	$wearprogress			0.00
}