customcharacter
{
	$materialmask			models/weapons/customization/glove_bloodhound/material_mask_brokenfang
	$ao						models/weapons/customization/glove_bloodhound/glove_brokenfang_ao
	
	$detail					models/weapons/customization/glove_bloodhound/detail
	$detailnormal			models/weapons/customization/glove_bloodhound/detailnormal
	$detailscale			"[ 2.800 2.200 6.000 4.000 ]"
	$detailphongboost 		"[ 0.15 0.300 0.000 0.000 ]"
	$detailenvboost 		"[ 0.05 1 0 0 ]"
	$detailphongalbedotint 	"[ 0.060 0.900 0.600 0.050 ]"
	$detailwarpindex 		"[ 0.045 0.130 0.010 0.010 ]"
	$detailmetalness 		"[ 1.000 0.200 1.000 1.000 ]"
	$detailnormaldepth		"[ 1.200 1.000 3.000 1.300 ]"
	
	"$palettecolor1" "[  71  69  17 ]"  // back of hand
	"$palettecolor2" "[ 255 211 130 ]"  // broken fang
	"$palettecolor3" "[ 208 180 129 ]"  // spikes
	"$palettecolor4" "[ 157 140 102 ]"  // snap and grommits
	"$palettecolor5" "[ 206 183 111 ]"  // trim
	"$palettecolor6" "[  40  42 45 ]"  // emblem leather area and palm
	"$palettecolor7" "[  30 30 35 ]"  // connector leather
	"$palettecolor8" "[  39  39  44 ]"  // fabric
	
	//PATTERN
	$pattern					"models\weapons\customization\materials\pattern_poison_frog01"
	$patternreplaceindex		1
	$patterncolorindices		"[ 8 0 1 5 ]"
	$patterndetailinfluence 	8.00
	$patternpaintthickness 		0.80
	$patternphongfactor 		0.05
	$pattern_offset_x_start		0
	$pattern_offset_x_end		1
	$pattern_offset_y_start		0
	$pattern_offset_y_end		1
	$pattern_rotate_start		0
	$pattern_rotate_end			0
	$patternscale				3.25
	$grungescale 				1.60
	
	//GRUNGE
	$grunge			models/weapons/customization/glove_bloodhound/grunge_sfx_brown
	$damagegrunge	"[ 1.00 0.10 0.80 0.40 ]"
	$detailgrunge 	"[ 0.30 0.10 0.00 0.00 ]"
	$grungemax 		"[ 0.60 1.00 1.00 1.00 ]"
	$grime			"[ .25 1 .25 .25 ]"
	
	//DAMAGE
	$damagelevels1 			"[ 0.080 0.100]"
	$damagelevels2 			"[ 0.400 1.800 ]"
	$damagelevels3 			"[ 0.000 1.000 ]"
	$damagelevels4 			"[ 0.000 1.000 ]"
	$damagenormaledgedepth 	"[ 3.000 1.000 1.000 0.000 ]"
	$damageedgephongboost 	"[ 4.000 2.000 0.500 0.500 ]"
	$damageedgeenvboost 	"[ 1.000 1.000 0.300 0.000 ]"
	//$damagedetailenvboost 	"[ 0.000 0.050 0.000 0.000 ]"
	$damagedetailenvboost 	"[ 1.000 1.000 0.300 0.000 ]"
	$damagedetailphongboost "[ 0.150 0.200 0.000 0.000 ]"
	$damagedetailsaturation "[ -0.50 -0.80 -0.10 0.000 ]"
	$damagedetailbrightnessadjustment "[ 1.000 0.000 1.000 0.000 ]"

	//WEAR
	$curvaturewearboost 	"[ 0.50 1.60 1.00 0.00 ]"
	$curvaturewearpower 	"[ 3.30 5.50 0.80 1.00 ]"
	$weardetailphongboost 	"[ -8.0 0.80 0.00 0.00 ]"
	$wearexponent			0.80
	$wearprogress			0.00
}