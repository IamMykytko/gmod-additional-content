customcharacter
{
	$materialmask			models/weapons/customization/glove_sporty/material_mask
 	$ao						models/weapons/customization/glove_sporty/ao
	
	$detail					models/weapons/customization/glove_sporty/detail
	$detailnormal			models/weapons/customization/glove_sporty/detailnormal
	$detailscale 			"[ 2.500 6.000 2.000 6.000 ]"
	$detailphongboost 		"[ 0.020 0.200 0.200 0.005 ]"
	$detailenvboost 		"[ 0.000 0.400 0.020 0.000 ]"
	$detailphongalbedotint 	"[ 0.000 0.800 0.000 0.000 ]"
	$detailwarpindex 		"[ 0.000 0.100 0.086 0.025 ]"
	$detailnormaldepth 		"[ 6.000 4.000 1.000 3.000 ]"
	
	"$palettecolor1" "[ 123  94  79 ]"   // wear color?
	"$palettecolor2" "[ 123  25  25 ]"   // back of fingers, wrist strap, and inner stitching
	"$palettecolor3" "[ 134 113  87 ]"   // palm pad and thumb wrap
	"$palettecolor4" "[ 153  46  46 ]"   // back of hand detail
	"$palettecolor5" "[ 195 180 180 ]"   // between fingers and lower trim/stitching
	"$palettecolor6" "[ 103  25  25 ]"   // back of hand lines
	"$palettecolor7" "[ 137 122  94 ]"   // strap logo
	"$palettecolor8" "[ 137 134 132 ]"   // palm

	//PATTERN
	$pattern					"models\weapons\customization\paints\spray\camo_cloud"
	$patternreplaceindex		8
	$patterncolorindices		"[ 7 1 8 3 ]"
	$patterndetailinfluence 	"0.60"
	$patternpaintthickness 		"0.40"
	$pattern_offset_x_start		0
	$pattern_offset_x_end		1
	$pattern_offset_y_start		0
	$pattern_offset_y_end		1
	$pattern_rotate_start		0.0
	$pattern_rotate_end			0.0
	$patternscale				2.22
	$grungescale 				2.50
	
	//GRUNGE
 	$grunge						models/weapons/customization/glove_sporty/grunge
	$grime 						"[ 1.800 2.000 1.000 0.100 ]"
	$grimesaturation 			"[ 0.100 0.100 0.100 0.000 ]"
	$grimebrightnessadjustment 	"[ 0.500 0.900 0.000 1.000 ]"
	$detailgrunge 				"[ 0.000 0.050 0.100 0.100 ]"
	$damagegrunge 				"[ 0.900 0.100 0.900 0.500 ]"
	$grungemax 					"[ 0.800 0.800 0.800 0.800 ]"
	
	//DAMAGE
	$damagelevels1 						"[ 0.010 0.040 ]"
	$damagelevels2 						"[ 0.019 0.027 ]"
	$damagelevels3 						"[ 0.009 0.015 ]"
	$damagelevels4 						"[ 0.005 0.060 ]"
	$damagedetailphongboost 			"[ 0.100 0.000 0.000 0.000 ]"
	$damagedetailenvboost 				"[ 0.000 0.000 0.000 0.000 ]"
	$damagenormaledgedepth 				"[ 3.000 4.000 4.000 1.000 ]"
	$damageedgephongboost 				"[ 2.000 4.000 4.000 2.000 ]"	
	$damageedgeenvboost 				"[ 0.050 0.500 0.500 0.050 ]"
	$damagedetailbrightnessadjustment 	"[ 0.000 0.100 0.000 -0.60 ]"
	$damagedetailsaturation 			"[ 0.000 -0.50 0.000 0.000 ]"
	
	//WEAR
	$weardetailphongboost 		"[ 0.000 0.000 0.000 0.000 ]"
	$weardetailenvboost 		"[ 0.000 0.000 0.000 0.000 ]"
	$curvaturewearboost 		"[ 0.100 0.900 0.100 0.100 ]"
	$curvaturewearpower			"[ 2.900 3.800 3.900 3.000 ]"
	$wearexponent				0.85
	$wearprogress				0.0
}