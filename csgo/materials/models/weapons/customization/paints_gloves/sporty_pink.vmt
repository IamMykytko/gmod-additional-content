customcharacter
{
	$materialmask			models/weapons/customization/glove_sporty/material_mask
 	$ao						models/weapons/customization/glove_sporty/ao
	
 	$grunge					models/weapons/customization/glove_sporty/grunge
	
	$grime 				"[.8 0 .1 .4]"
	$damagegrunge		"[.2 0 .1 .4]"
	
	"$palettecolor1" "[ 22.000000 22.000000 22.000000 ]"
	"$palettecolor2" "[ 230.000000 10.000000 160.000000 ]"
	"$palettecolor3" "[ 37.000000 37.000000 37.000000 ]"
	"$palettecolor4" "[ 60.000000 60.000000 60.000000 ]"
	"$palettecolor5" "[ 29.000000 180.000000 210.000000 ]"
	"$palettecolor6" "[ 54.000000 180.000000 195.000000 ]"
	"$palettecolor7" "[ 223.000000 223.000000 223.000000 ]"
	"$palettecolor8" "[ 64.000000 86.000000 91.000000 ]"
		
	$patternreplaceindex		8
	
	$pattern					"models\weapons\customization\paints\hydrographic\poly_camo"
	$patterncolorindices		"[ 4.000000 8.000000 4.000000 1.000000 ]"
	
	$detail					models/weapons/customization/glove_sporty/detail2
	$detailnormal			models/weapons/customization/glove_sporty/detailnormal2

	$detailscale "[ 2.500000 5.00000 2.000000 6.000000 ]"
	$detailphongboost "[ 0.1000 1.0000 0.200000 0.00500 ]"
	$detailenvboost "[ 0.000000 0.4000 0.020000 0.000000 ]"
	$detailphongalbedotint "[ 0.400000 0.400000 0.00000 0.000000 ]"
	$detailwarpindex "[ 0.0000 0.1000 0.086000 0.0250000 ]"
	$detailmetalness "[ 1.000000 1.000000 1.000000 1.000000 ]"
	$detailnormaldepth "[ 2.000000 8.00000 1.000000 3.000000 ]"
	
	$weardetailphongboost "[ 0.000000 0.000000 0.000000 0.000000 ]"
	$weardetailenvboost "[ 0.000000 0.000000 0.000000 0.000000 ]"
			
	$damagedetailphongboost "[ 0.10000 0.000000 0.00000 0.000000 ]"
	$damagedetailenvboost "[ 0.00000 0.0000 0.000000 0.000000 ]"
	$damagenormaledgedepth "[ 0.50000 4.00000 1.000000 1.000000 ]"
	$damageedgephongboost "[ 0.00000 0.00000 0.00000 0.000000 ]"	
	$damageedgeenvboost "[ 0.000000 0.000000 0.00000 0.000000 ]"
	$damagedetailbrightnessadjustment "[ 0.50000 1.000000 0.500000 0.70000 ]"
	$damagedetailsaturation "[-0.5 -0.5 0.5 0.5]"
	
		
	$curvaturewearboost "[ 0.10000 0.90000 0.100000 0.10000 ]"
	$curvaturewearpower	"[ 3.000000 4.0000 4.000000 3.000000 ]"

	$detailgrunge "[ 0.000000 0.050000 0.100000 0.100000 ]"
	
	$damagelevels1 "[ 0.018000 0.090000 ]"
	$damagelevels2 "[ 0.008000 0.025000 ]"
	$damagelevels3 "[ 0.01000 0.02000 ]"
	$damagelevels4 "[ 0.018000 0.090000 ]"
	
	$detailgrungefactor "[0 0 0 0]"

	$wearexponent				0.5
	
	"$patterndetailinfluence" "32.000000"
	"$patternpaintthickness" "0.400000"

	// paintkit values, don't affect preview
	$pattern_offset_x_start		0
	$pattern_offset_x_end		1
	$pattern_offset_y_start		0
	$pattern_offset_y_end		1
	$pattern_rotate_start		30.0
	$pattern_rotate_end			30.0
	$patternscale				5.0
	$grungescale 				2.500000
	// end paintkit values
	$patterntexturetransform "scale 5.000000 5.000000 translate 0.000000 0.000000 rotate 30.0"
	$grungetexturetransform "scale 2.5 2.5 translate 0.000000 0.000000 rotate 0"
}