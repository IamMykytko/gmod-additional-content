	"$palettecolor6" "[ 169.000000 163.000000 139.000000 ]"		// stitching
	"$palettecolor7" "[ 220.000000 220.000000 220.000000 ]"		// inbetween fingers
	"$palettecolor8" "[ 255.000000 255.000000 0.000000 ]"		// icon and back slice
	
