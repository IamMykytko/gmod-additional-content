	"$palettecolor1" "[ 20.000000 20.000000 20.000000 ]"		// palm and fingers top/bottom	
	"$palettecolor2" "[ 22.000000 44.000000 16.000000 ]"		// unused?
	"$palettecolor3" "[ 99.000000 121.000000 97.000000 ]"		// palm pad and index finger tip
	"$palettecolor4" "[ 31.000000 61.000000 22.000000 ]"		// knucle armor, index/thumb web, and strap brace/buckle
