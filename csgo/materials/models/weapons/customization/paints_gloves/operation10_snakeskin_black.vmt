	"$palettecolor1" "[ 203 196 188 ]" // back of hand
	"$palettecolor2" "[  77  77  82 ]" // broken fang
	"$palettecolor3" "[ 127 127 131 ]" // spikes
	"$palettecolor4" "[  91  92  98 ]" // snap and grommits
	"$palettecolor5" "[  28  28  28 ]" // trim
