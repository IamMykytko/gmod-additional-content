VertexLitGeneric
{

$baseTexture "models\props\de_train\hr_t\metal_grate\metal_grate.vtf"

$bumpmap "models\props\de_train\hr_t\metal_grate\metal_grate_normals.vtf"
	"$phong" "1"
	"$phongboost" "1"
	"$phongalbedoboost" "1"
	"$phongfresnelranges" "[.9 .9 1]"
	"$phongexponent" 180
	//$blendtintbybasealpha 1
	

 "$normalmapalphaenvmapmask" 1


	"$detail" 				"detail\detailconcrete001a"
	"$detailscale" 			"[6 6 6]"
	"$detailblendfactor" 	"1"

		
	"$envmap" "env_cubemap"

	"$envmaptint" 		"[.3 .3 .3]"

	"$phongalbedotint" "1"
	"$phongdisablehalflambert" "1"



}
