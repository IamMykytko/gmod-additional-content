"VertexlitGeneric"
{
	"$basetexture" "models\props\coop_kashbah\hardcase_color"

	"$bumpmap" "models\props\coop_kashbah\hardcase_normal"
	"$normalmapalphaenvmapmask" "1"

	"$envmap" "env_cubemap"
	"$envmaptint" 		"[.1 .1 .1]"	


        "$phong" "1"
        "$phongexponent" "120.0"
	"$phongboost" ".2"
	"$phongfresnelranges" "[0.8 0.8 1]"
	"$envmaplightscale"		"1"
	"$envmaplightscaleminmax" 	"[0 1]"


}