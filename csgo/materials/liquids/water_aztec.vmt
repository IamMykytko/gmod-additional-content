Water
{
	$forceexpensive 1
	$normalmap "liquids/water_river_normal_sharp"
	$flowmap "liquids/c3m1_hflowmap"
	$flow_normaluvscale 155.0
	$flow_worlduvscale 0.5
	$flow_timeintervalinseconds 0.2 
	$flow_uvscrolldistance 0.075 
	$flow_bumpstrength 0.4
	$flow_timescale 0.5
	$flow_noise_texture "liquids/water_noise"
	$flow_noise_scale 0.0003
	$flow_debug 0
	$reflecttexture _rt_WaterReflection
	$reflectamount ".4"
	$reflecttint "{ 190 190 190 }"
	"!gameconsole?$refracttexture" _rt_WaterRefraction

//	$reflectskyboxonly 0
	$reflect2dskybox 1
//	$reflectentities 1
	$reflectonlymarkedentities 1

	"gameconsole?$refract"	0
	"!gameconsole?$refract"	1
	"!gameconsole?$refractamount" "0.15"
	"!gameconsole?$refracttint" "{ 151 135 34 }"
	
	$abovewater 1
	$bottommaterial "liquids/water_swamp_m1_beneath"
	$fogenable 1
	$fogstart 0
	$fogend 24
	$lightmapwaterfog 1

	$fogcolor "{ 90 70 20 }"
	$flashlighttint 1
	"%compilewater" 1
	"%tooltexture" "nature/water_frame01_normal"
	$surfaceprop slime
	
	"GPU<2"
	{
		"$fallbackmaterial" "liquids/water_aztec_cheap"
	}
	
    // pseudo-translucent water only gets used on platforms which disable refract (as a cheaper substitute for refractive water)
    "gameconsole?$pseudotranslucent" 1
    "gameconsole?$waterblendfactor" 0.75
//	"gameconsole?$fallbackmaterial" "liquids/water_aztec_cheap"
}
