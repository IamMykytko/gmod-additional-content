	//"$reflecttexture" "_rt_WaterReflection"
	//"$reflecttexture" "tools/toolsblack"
	"$reflecttint" "{ 120 160 140}"
	//"$reflectentities" 1
	"$reflectamount" "0.9"


    // Refraction
	$refract 0
	//"$refracttexture" "_rt_WaterRefraction"
