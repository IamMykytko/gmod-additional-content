"Water"
{
	"%compilewater" 1
	"%tooltexture" "dev/water_normal"

	// This is cheap fallback water
	$forcecheap 1

	"$abovewater" 1
	"$surfaceprop" "water"
	"$bottommaterial" "dev/dev_waterbeneath2"
	"$normalmap" "dev/water_normal"
		

	$scroll1 "[0.01 0.02]"
	$scroll2 "[-0.02 0.01]"

    // Reflection
//	$envmap env_cubemap
	$envmap /maps/de_canals/c-512_-3072_32.hdr


	//$reflectonlymarkedentities 1
