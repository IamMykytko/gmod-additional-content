UnLitTwoTexture
{
"%tooltexture" "effects/smoke_plumes_00_thick"
$basetexture "effects/smoke_plumes_scroll_thick"
$texture2 "effects/smoke_plumes_00_thick"

$translucent 1

$nocull 1
$no_fullbright 1
$nofog 1
$scale "[1 1]"
$scroll "[2 2]"
Proxies
{
LinearRamp
{
resultVar "$scroll[0]"
rate -.01
}
LinearRamp
{
resultVar "$scroll[1]"
rate .020
}
TextureTransform
{
scaleVar $scale
translateVar $scroll
resultVar $basetexturetransform
}
}
}
