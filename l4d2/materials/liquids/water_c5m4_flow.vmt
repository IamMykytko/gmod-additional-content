Water
{
$normalmap "liquids/water_river_normal_sharp"
$flowmap "liquids/c5m4_hflowmap"
$flow_normaluvscale 180.0
$flow_worlduvscale 0.5
$flow_timeintervalinseconds 0.5 
$flow_uvscrolldistance 0.15 
$flow_bumpstrength 0.4
$flow_timescale 1.0
$flow_noise_texture "liquids/water_noise"
$flow_noise_scale 0.0004
$flow_debug 0
$reflecttexture _rt_WaterReflection
$reflectamount "0.4"
$reflecttint "{ 210 210 210 }"
$reflectskyboxonly 1
$reflectentities 1
$abovewater 1
$bottommaterial "nature/water_swamp_beneath"
$fogenable 1
$fogstart 0
$fogend 2500
$lightmapwaterfog 0

$fogcolor "{ 9 7 1 }"
$flashlighttint 50
"%compilewater" 1
"%tooltexture" "nature/water_frame01_normal"
$surfaceprop water
}
