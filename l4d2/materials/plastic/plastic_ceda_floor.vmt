LightmappedGeneric
{
$baseTexture "plastic/plastic_ceda_floor"
$surfaceprop upholstery
$envmap env_cubemap
$envmapcontrast ".75"
$envmaptint "[ .15 .15 .15 ]"
$bumpmap "plastic\plastic_ceda_floor-ssbump"
$ssbump 1
$normalmapalphaenvmapmask 1
$blendtintbybasealpha 1
$color2 "[ .25 .55 .45 ]" 
"%keywords" l4d2
}