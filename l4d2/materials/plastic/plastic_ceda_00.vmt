LightmappedGeneric
{
$baseTexture "plastic/plastic_ceda_00"
$surfaceprop upholstery
$envmap env_cubemap
$envmapcontrast ".75"
$envmaptint "[ .15 .15 .15 ]"
$bumpmap "plastic\plastic_ceda_00-ssbump"
$ssbump 1
$normalmapalphaenvmapmask 1
$blendtintbybasealpha 1
$color2 "[ .5 .5 .5 ]" 
"%keywords" l4d2
}