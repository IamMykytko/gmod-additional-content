LightmappedGeneric
{

$basetexture "ti/zwater_new"
$bumpmap "liquids/water_normal_x"

$nodecal 1
$envmap env_cubemap
$envmaptint "[0.7 0.65 0.6]"
$envmapcontrast 1
$envmapsaturation "0.1"
$translucent 1

Proxies
{
TextureScroll
{
texturescrollvar $basetexturetransform
texturescrollrate 0.4
texturescrollangle -90
}
TextureScroll
{
texturescrollvar $bumptransform
texturescrollrate 0.45
texturescrollangle -85
}
}
}
