UnlitTwoTexture
{
"%tooltexture" "ti/fire1"
$basetexture "ti/fire1"
$texture2 "ti/fire1_anim"
$additive 1
$selfillum 1
$bloom 1
$nocull 1
$no_fullbright 1
$nofog 1
$scale "[1 1]"
$scroll "[2 2]"
Proxies
{
LinearRamp
{
resultVar "$scroll[0]"
rate -.01
}
LinearRamp
{
resultVar "$scroll[1]"
rate .25
}
TextureTransform
{
scaleVar $scale
translateVar $scroll
resultVar $basetexturetransform
}
}
}
